{
  "permissions": {
    "allow": [
      "Bash(./scripts/gem.sh:*)",
      "Bash(./scripts/daily_blog.sh)",
      "Bash(python3 scripts/keyword_radar.py:*)",
      "Bash(python3 scripts/style_check.py:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "WebSearch",
      "WebFetch",
      "Read",
      "Edit(posts/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/daily_blog.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
